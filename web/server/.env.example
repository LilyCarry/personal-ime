# Admin token required by POST /api/reset (pass via X-Admin-Token header)
ADMIN_TOKEN=change-me-before-deploy

# Optional SQLite database file path (defaults to web/server/leaderboard.db)
LEADERBOARD_DB_PATH=web/server/leaderboard.db

# Comma-separated CORS allowed origins, or * for all
CORS_ORIGINS=*

# DeepSeek API configuration for POST /api/analyze (optional; falls back locally if unset)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SEC=6.0
